{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info]}.

{deps, [
    {livery, "~> 0.4.4"},
    {livery_s3, "~> 0.1.1"}
    %% rocksdb ~> 3.1.0 is added in Phase 4 (T4.1), where the metadata
    %% store lands, to keep early builds light.
]}.

{profiles, [
    {test, [
        {deps, [{proper, "~> 1.4"}]},
        {plugins, [rebar3_proper]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose]}
    ]}
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [crypto, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.
