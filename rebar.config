{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info]}.

{pre_hooks, [
    {"(linux|darwin|solaris|freebsd|openbsd|netbsd)", compile, "make -C c_src"},
    {"(linux|darwin|solaris|freebsd|openbsd|netbsd)", clean, "make -C c_src clean"}
]}.

{deps, [
    {livery, "~> 0.4.4"},
    {livery_s3, "~> 0.1.1"},
    {rocksdb, "~> 3.1.0"}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"}
]}.

{profiles, [
    {test, [
        {deps, [{proper, "~> 1.4"}]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose]}
    ]}
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [crypto, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

{erlfmt, [
    write,
    {files, [
        "{src,test,include}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.

%% Style is enforced, size limits have no ignore lists on purpose: when a
%% module trips max_module_length or no_god_modules, split it instead of
%% adding an exception.
{elvis, [
    {config, [
        #{
            files => ["src/**/*.erl"],
            rules => [
                {elvis_style, no_macros, disable},
                %% Strict generators need OTP 28; we support 27.
                {elvis_style, prefer_strict_generators, disable},
                %% elvis_core 5.x additions that fight readability here.
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"
                }},
                {elvis_text_style, max_line_length, #{limit => 120}},
                %% Keep files small: split modules rather than ignoring.
                {elvis_style, max_module_length, #{max_length => 500}},
                {elvis_style, max_function_length, #{max_length => 30}},
                {elvis_style, no_god_modules, #{limit => 30}}
            ],
            ruleset => erl_files_strict
        },
        #{
            files => ["include/*.hrl"],
            ruleset => hrl_files
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        }
    ]}
]}.
