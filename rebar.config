{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info]}.

{pre_hooks, [
    {"(linux|darwin|solaris|freebsd|openbsd|netbsd)", compile, "make -C c_src"},
    {"(linux|darwin|solaris|freebsd|openbsd|netbsd)", clean, "make -C c_src clean"}
]}.

{deps, [
    {livery, "~> 0.4.4"},
    {livery_s3, "~> 0.1.1"},
    {rocksdb, "~> 3.1.0"},
    %% Pinned explicitly to the latest: the client's HTTP transport
    %% (via livery_client_hackney) and the test suites depend on it.
    {hackney, "~> 4.4.5"}
]}.

%% proper 1.5.0 (its latest release) still uses the old `catch Expr` form
%% in proper_statem.erl, which OTP 29 deprecated. It is a test-only dep, so
%% silence that one warning for it rather than patch the vendored source.
{overrides, [
    {add, proper, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12"},
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"}
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_apps, top_level_deps},
    %% h1 is livery's HTTP/1 engine; we touch it for server_port/1.
    %% instrument is transitive via livery; xet_metrics calls it directly.
    {plt_extra_apps, [crypto, public_key, ssl, h1, instrument, os_mon]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

%% `rebar3 escriptize` builds the `xet` CLI. Note: the BLAKE3/LZ4/rocksdb
%% NIFs make a self-contained escript awkward (shared objects must be
%% unpacked); prefer a release for deployment. The escript is a
%% convenience for local use where the built libs are on the path.
{escript_name, "xet"}.
{escript_main_app, barrel_xet}.
{escript_emu_args, "%%! +sbtu +A1 -escript main xet_cli\n"}.

%% Standalone CAS server release: `rebar3 as prod release` builds a node
%% that autostarts the server from config/sys.config.src, whose
%% ${VAR:-default} placeholders the start script substitutes from the
%% environment on every boot (see the BARREL_XET_* vars in that file).
{relx, [
    %% os_mon is bundled (xet_disk uses disksup for free-space checks)
    %% but loaded only; xet_disk starts it with disksup alone.
    {release, {barrel_xet, "0.1.0"}, [barrel_xet, {os_mon, load}]},
    {mode, dev},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {deps, [{proper, "~> 1.4"}]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {cover_enabled, true},
        {cover_opts, [verbose, {min_coverage, 70}]}
    ]},
    {prod, [
        {relx, [{mode, prod}, {include_erts, true}]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "{src,test,include}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.

%% Style is enforced, size limits have no ignore lists on purpose: when a
%% module trips max_module_length or no_god_modules, split it instead of
%% adding an exception.
{elvis, [
    {config, [
        #{
            files => ["src/**/*.erl"],
            rules => [
                {elvis_style, no_macros, disable},
                %% Strict generators need OTP 28; we support 27.
                {elvis_style, prefer_strict_generators, disable},
                %% elvis_core 5.x additions that fight readability here.
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"
                }},
                {elvis_text_style, max_line_length, #{limit => 120}},
                %% Keep files small: split modules rather than ignoring.
                {elvis_style, max_module_length, #{max_length => 500}},
                {elvis_style, max_function_length, #{max_length => 30}},
                {elvis_style, no_god_modules, #{limit => 30}}
            ],
            ruleset => erl_files_strict
        },
        #{
            files => ["include/*.hrl"],
            ruleset => hrl_files
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        }
    ]}
]}.
