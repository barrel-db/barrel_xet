%% Standalone CAS server configuration for the release.
%%
%% The `server` map is passed to xet_server:start_instance/1 on boot.
%% Override for your deployment (data_dir, listeners, auth, secrets).
[
    {barrel_xet, [
        {server, #{
            name => barrel_xet,
            data_dir => "/var/lib/barrel_xet",
            http => #{port => 8080},
            %% Signed data URLs survive restarts by default: the secret
            %% is generated once and persisted in the metadata store.
            %% Set url_secret explicitly only to manage it yourself
            %% (for example, shared across nodes).
            %% url_secret => <<"...32 bytes...">>,
            auth =>
                {xet_auth_static, #{
                    tokens => #{
                        <<"change-me-write">> => write,
                        <<"change-me-read">> => read
                    }
                }}
        }}
    ]}
].
