# barrel_xet environment. Copy to /etc/barrel_xet/env (root:barrel-xet, 0640;
# it may hold BARREL_XET_URL_SECRET). Every value has a built-in default, so
# uncomment only what you need to change. See docs/deploy-server.md.

# BARREL_XET_HTTP_PORT=8080
# BARREL_XET_DATA_DIR=/var/lib/barrel_xet
# BARREL_XET_TOKENS_FILE=/etc/barrel_xet/tokens
# BARREL_XET_LOG_LEVEL=notice

# Shared across replicas so signed /data URLs survive a restart. If unset,
# the node persists a generated secret in its metadata (single-node only).
# BARREL_XET_URL_SECRET=

# HTTPS: set all three to enable. Empty cert/key are dropped, so leaving
# these commented serves cleartext only.
# BARREL_XET_HTTPS_PORT=8443
# BARREL_XET_TLS_CERT=/etc/barrel_xet/tls/cert.pem
# BARREL_XET_TLS_KEY=/etc/barrel_xet/tls/key.pem

# Distribution node name (needed for `eval`-based reload/admin).
# BARREL_XET_NODE=barrel_xet@127.0.0.1
